# ──────────────────────────────────────────────
# Backend Environment Variables (apps/api)
# Copy this file to apps/api/.env and update values
# ──────────────────────────────────────────────

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:Alpha01@localhost:5432/portfolio

# Authentication Security (JWT secrets must be at least 32 characters)
JWT_SECRET=your-secret-key-at-least-32-characters-long
JWT_REFRESH_SECRET=your-refresh-secret-at-least-32-chars
# Token Lifespan Configuration (access token in minutes, refresh token in days)
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001

# File Storage Configuration (local | cloudinary)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

# Cloudinary Storage (Optional — used if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email / SMTP Configuration (Optional — used for contact form notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
