# ──────────────────────────────────────────────
# Frontend Environment Variables (apps/web)
# Copy this file to apps/web/.env and update values
# ──────────────────────────────────────────────

# REST API Base URL (must point to the Express backend /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Visitor Telemetry & Analytics Feature Flag
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# Admin Session Countdown Fallback (in minutes, default 15)
NEXT_PUBLIC_JWT_ACCESS_TTL_MINUTES=15
