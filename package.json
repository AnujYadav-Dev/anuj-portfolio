{
  "name": "portfolio",
  "private": true,
  "version": "0.0.1",
  "description": "Dynamic portfolio platform — Next.js + Express + PostgreSQL",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @portfolio/api",
    "dev:web": "npm run dev -w @portfolio/web",
    "build:shared": "npm run build -w @portfolio/shared",
    "build:api": "npm run build -w @portfolio/api",
    "build:web": "npm run build -w @portfolio/web",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test:api && npm run test:web",
    "test:api": "npm run test -w @portfolio/api",
    "test:web": "npm run test -w @portfolio/web",
    "test:e2e": "playwright test",
    "test:coverage": "npm run test:coverage -w @portfolio/api && npm run test:coverage -w @portfolio/web",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
